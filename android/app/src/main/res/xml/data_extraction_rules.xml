<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (dataExtractionRules).

    Same reasoning as backup_rules.xml: naming the preferences file in an
    <include> already excludes everything else, so the diagnostics log never
    leaves the device by either route. A redundant <exclude> for it fails lint.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="charger_greetings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="charger_greetings.xml" />
    </device-transfer>
</data-extraction-rules>
