<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      RECEIVE_BOOT_COMPLETED re-baselines the charger state after a restart:
      without it, the first plug or unplug after every reboot would either be
      missed or greeted incorrectly.

      FOREGROUND_SERVICE + FOREGROUND_SERVICE_SPECIAL_USE run PowerWatcherService,
      which is what actually catches ACTION_POWER_CONNECTED/_DISCONNECTED
      reliably. This was NOT the original design; see PowerWatcherService's
      class comment for why a plain manifest receiver turned out not to be
      enough. POST_NOTIFICATIONS is required from Android 13 for that service's
      own status notification to display at all (Android 13+ notifications are
      opt-in; the app functions with it denied, the notification just won't show).

      Deliberately NOT requested:
        INTERNET  - the app never makes a network call
        WAKE_LOCK - not needed: foreground-service state already keeps the
                    process from being suspended, and the clip is ~1.6 s
        Anything else - no accessibility service, no device admin, no storage
                    permission (the Storage Access Framework grants per-file
                    access without one)
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      REQUEST_IGNORE_BATTERY_OPTIMIZATIONS shows the one-tap system dialog that
      exempts this app from Doze. It is load-bearing, not a convenience: on
      Android 12+ an app that is NOT exempt cannot start a foreground service
      from the background, which is exactly what the watchdog must do to repair
      monitoring after an OEM kills it. Without it the app silently stops
      working until reopened by hand, which is the bug this release fixes.

      Play policy note: this permission is restricted to apps whose core
      function requires continuous background execution. That is the case here
      and must be declared in the Play listing if this is ever published.
      The app still functions without the exemption; recovery just degrades to
      "reopen the app", and the setup screen says so plainly.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      RECORD_AUDIO is requested at runtime ONLY when the user taps "Record your
      voice", never at launch. The microphone is opened solely from that screen:
      no service, receiver or worker can reach VoiceRecorder, so the app cannot
      record in the background even by mistake. Recordings are written to
      app-private storage and are removed when the app is uninstalled.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChargerGreetings"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ChargerGreetings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Best-effort second path only, NOT the reliable mechanism. These two
          actions are not on Android's implicit-broadcast exemption list (see
          PowerEventReceiver.kt for the verification). PowerWatcherService is
          what actually works; this stays registered because it costs nothing
          and is a free bonus on whatever device/OS combination still lets it
          through.

          android:exported="false" - these are system broadcasts delivered to us
          directly; no other app has any reason to trigger this receiver.
        -->
        <receiver
            android:name=".power.PowerEventReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!--
          The reliable mechanism. See PowerWatcherService.kt for the full
          rationale. specialUse is the correct Android 14+ foreground-service
          type for "watch for a hardware state change and react"; there is no
          better-fitting predefined category.
        -->
        <service
            android:name=".power.PowerWatcherService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches for the charger being connected or disconnected so it can play a spoken greeting" />
        </service>

        <receiver
            android:name=".power.BootReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- LOCKED_BOOT_COMPLETED fires earlier, before first unlock.
                     This receiver is not directBootAware, so on encrypted
                     devices Android holds it until unlock; it is listed so
                     devices without file-based encryption still restore
                     promptly. BootReceiver defers on it rather than reading
                     preferences that may not be decryptable yet. -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- Some OEM ROMs send only one of these; accepting all of them
                     is the difference between working and not on those devices. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
