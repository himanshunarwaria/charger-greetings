# Release signing configuration -- TEMPLATE.
#
# 1. Copy this file to  android/keystore.properties
# 2. Fill in the real values
# 3. NEVER commit the filled-in file or the .jks itself
#
# Create a keystore with (all one line) -- run it from the android/ folder,
# right next to this file, so the relative path below is correct:
#
#   keytool -genkeypair -v -keystore charger-greetings-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias release
#
# Note: modern (PKCS12) keystores require the store password and key password
# to be identical -- keytool will silently ignore a different -keypass value
# and use -storepass for both. Use the same value for both fields below.
#
# storeFile is resolved by Gradle's file() relative to the *app* module
# directory (android/app/), not this file's own directory (android/) -- so a
# keystore placed next to keystore.properties needs one extra "../" here.
# When in doubt, use an absolute path instead; it is machine-local anyway.
#
# Keep the .jks and this password backed up somewhere safe. If you lose them
# you cannot ship an update to an app already published under this key.

storeFile=../../charger-greetings-release.jks
storePassword=CHANGE_ME
keyAlias=release
keyPassword=CHANGE_ME
